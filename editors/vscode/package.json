{
  "name": "webtest-vscode",
  "displayName": "WebTest",
  "description": "Language support and runtime diagnostics for WebTest",
  "version": "0.2.0",
  "publisher": "webtest",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Debuggers"
  ],
  "keywords": [
    "webtest",
    "testing",
    "browser",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:webtest",
    "onCommand:webtest.runCurrentFile",
    "onCommand:webtest.debugCurrentFile",
    "onDebug",
    "onCommand:webtest.installServer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "webtest",
        "aliases": [
          "WebTest",
          "webtest"
        ],
        "extensions": [
          ".webtest"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "webtest.runCurrentFile",
        "title": "WebTest: Run Current File"
      },
      {
        "command": "webtest.debugCurrentFile",
        "title": "WebTest: Debug Current File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "webtest.installServer",
        "title": "WebTest: Install/Update Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "webtest.runCurrentFile",
          "when": "editorLangId == webtest",
          "group": "navigation"
        },
        {
          "command": "webtest.debugCurrentFile",
          "when": "editorLangId == webtest",
          "group": "navigation"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "webtest"
      }
    ],
    "debuggers": [
      {
        "type": "webtest",
        "label": "WebTest Debug",
        "languages": [
          "webtest"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .webtest file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before the first test step.",
                "default": false
              },
              "headed": {
                "type": "boolean",
                "description": "Show Chrome while debugging.",
                "default": true
              },
              "chromePath": {
                "type": "string",
                "description": "Optional Chrome executable override."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment overrides for the debug adapter and its owned application, merged with the editor environment."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "webtest",
            "request": "launch",
            "name": "Debug WebTest",
            "program": "${file}",
            "headed": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "WebTest: Debug",
            "description": "Debug the active WebTest file in headed Chrome.",
            "body": {
              "type": "webtest",
              "request": "launch",
              "name": "Debug WebTest",
              "program": "${file}",
              "headed": true
            }
          }
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "webtest",
        "scopes": {
          "keyword": [
            "keyword.control.webtest"
          ],
          "string": [
            "string.quoted.double.webtest"
          ],
          "comment": [
            "comment.line.double-slash.webtest"
          ],
          "function": [
            "support.function.locator.webtest"
          ],
          "variable": [
            "variable.other.readwrite.webtest"
          ],
          "property": [
            "variable.other.property.webtest"
          ],
          "type": [
            "entity.name.type.webtest"
          ],
          "parameter": [
            "variable.parameter.webtest"
          ],
          "namespace": [
            "entity.name.namespace.webtest"
          ],
          "fixture": [
            "entity.name.type.fixture.webtest"
          ],
          "test": [
            "entity.name.function.test.webtest"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[webtest]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "WebTest",
      "properties": {
        "webtest.serverPath": {
          "type": "string",
          "default": "webtest",
          "scope": "resource",
          "description": "Executable override. Otherwise checks workspace target/debug/webtest, PATH, then the verified extension-managed release. Activation never downloads binaries."
        },
        "webtest.chromePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Chrome executable used by WebTest debug sessions."
        },
        "webtest.debug.stopOnEntry": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Pause before the first operation for current-file and Testing view debug sessions. An explicit launch stopOnEntry overrides this setting."
        },
        "webtest.environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "window",
          "description": "Environment overrides for the language server, debug adapter, and their owned applications. Supports ${env:NAME} from the editor environment. Reload the window after changes. Explicit debug launch env entries take precedence."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package",
    "smoke": "npm run package && node ./scripts/package-smoke.mjs",
    "smoke:cursor": "npm run smoke && node ./scripts/cursor-smoke.mjs",
    "smoke:activation": "npm run compile && node ./test/run.mjs",
    "test:testing": "npm run compile && node --test test/testing-api.cjs",
    "test:configuration": "npm run compile && node --test test/configuration.cjs",
    "test:releases": "npm run compile && node --test test/releases.cjs"
  },
  "dependencies": {
    "sigstore": "4.1.1",
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@sigstore/rekor-types": "^4.0.0",
    "@types/make-fetch-happen": "^10.0.4",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.7.0",
    "yauzl": "^3.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williamcotton/webtest"
  },
  "homepage": "https://github.com/williamcotton/webtest#readme",
  "bugs": {
    "url": "https://github.com/williamcotton/webtest/issues"
  }
}
